PGADMIN_PASSWORD=YourPgAdminPasswordHere_ReplaceMe

# GRAFANA ADMIN CREDENTIALS
GRAFANA_USER=admin
GRAFANA_PASSWORD=YourGrafanaPasswordHere_ReplaceMe
